let allData = { Cleaner: [], LoadUnload: [] };
let activeCat = 'Cleaner';
let currentQuestions = [];
let currentIndex = 0;
let userAnswers = {};
const optionLabels = ['A', 'B', 'C', 'D'];

const qText = document.getElementById('question-text');
const optionsContainer = document.getElementById('options-container');
const prevBtn = document.getElementById('prevBtn');
const nextBtn = document.getElementById('nextBtn');

let timeLeft = 30 * 60;
let timerInt;

// ১. ফায়ারবেস থেকে ডাটা লোড করার ফাংশন
async function fetchQuestionsFromFirebase() {
    try {
        const docSnap = await getDoc(dbRef);
        if (docSnap.exists()) {
            allData = docSnap.data();
        } else {
            await setDoc(dbRef, defaultData);
            allData = defaultData;
        }
        initExam();
    } catch (error) {
        console.error("Firebase Error:", error);
        qText.innerText = "সার্ভার কানেক্ট করতে সমস্যা হচ্ছে! আপনার ইন্টারনেট কানেকশন বা Firestore Rules চেক করুন।";
    }
}

// ২. ফায়ারবেসে ডাটা সেভ করার ফাংশন
async function saveDataToFirebase() {
    try {
        await setDoc(dbRef, allData);
        alert("সার্ভারে সফলভাবে সেভ হয়েছে!");
    } catch (error) {
        console.error("Firebase Update Error:", error);
        alert("সেভ হতে সমস্যা হয়েছে! দয়া করে ইন্টারনেট কানেকশন চেক করুন।");
    }
}

function startTimer() {
    clearInterval(timerInt);
    timeLeft = 30 * 60;
    timerInt = setInterval(() => {
        if (timeLeft <= 0) { clearInterval(timerInt); window.submitExam(); }
        else {
            timeLeft--;
            let m = Math.floor(timeLeft / 60);
            let s = timeLeft % 60;
            document.getElementById('timer').innerText = `${m}:${s < 10 ? '0' : ''}${s}`;
        }
    }, 1000);
}

window.switchCategory = function(cat) {
    activeCat = cat;
    document.getElementById('tab-cleaner').classList.remove('active');
    document.getElementById('tab-load').classList.remove('active');
    
    if(cat === 'Cleaner') document.getElementById('tab-cleaner').classList.add('active');
    else document.getElementById('tab-load').classList.add('active');

    userAnswers = {};
    initExam();
}

function initExam() {
    currentQuestions = allData[activeCat] || [];
    currentIndex = 0;
    
    if(currentQuestions.length === 0) {
        document.getElementById('q-circle-num').innerText = "?";
        qText.innerText = "এই ক্যাটাগরিতে কোনো প্রশ্ন নেই। এডমিন প্যানেল থেকে সার্ভারে যোগ করুন।";
        optionsContainer.innerHTML = "";
        document.getElementById('question-palette').innerHTML = "";
        prevBtn.style.visibility = 'hidden';
        nextBtn.style.visibility = 'hidden';
        return;
    }
    
    renderPalette();
    loadQuestion(0);
    startTimer();
}

function renderPalette() {
    const paletteBox = document.getElementById('question-palette');
    paletteBox.innerHTML = '';
    currentQuestions.forEach((_, i) => {
        let btn = document.createElement('button');
        btn.className = 'pal-btn';
        if (i === currentIndex) btn.classList.add('current');
        else if (userAnswers[i] !== undefined) btn.classList.add('answered');
        
        btn.innerText = i + 1;
        btn.onclick = () => loadQuestion(i);
        paletteBox.appendChild(btn);
    });
}

function loadQuestion(index) {
    currentIndex = index;
    const q = currentQuestions[index];
    
    document.getElementById('q-circle-num').innerText = index + 1;
    qText.innerText = q.q;
    
    let html = '';
    q.opts.forEach((opt, i) => {
        if(opt && opt.trim() !== '') {
            let isSelected = userAnswers[index] === i;
            html += `
            <div class="option-box ${isSelected ? 'selected' : ''}" onclick="selectAns(${i})">
                <input type="radio" name="ans" ${isSelected ? 'checked' : ''}>
                <span class="opt-label">${optionLabels[i]}.</span>
                <span class="opt-text">${opt}</span>
            </div>`;
        }
    });
    optionsContainer.innerHTML = html;
    
    prevBtn.style.visibility = currentIndex === 0 ? 'hidden' : 'visible';
    if (currentIndex === currentQuestions.length - 1) {
        nextBtn.innerText = "শেষ প্রশ্ন";
        nextBtn.style.background = "#ff5a79";
    } else {
        nextBtn.innerText = "এগিয়ে যান...";
        nextBtn.style.background = "#20a897";
    }
    renderPalette();
}

window.selectAns = function(optIndex) {
    userAnswers[currentIndex] = optIndex;
    loadQuestion(currentIndex);
}

prevBtn.onclick = () => { if (currentIndex > 0) loadQuestion(currentIndex - 1); };
nextBtn.onclick = () => { 
    if (currentIndex < currentQuestions.length - 1) loadQuestion(currentIndex + 1); 
    else window.submitExam(); 
};

window.submitExam = function() {
    if(currentQuestions.length === 0) return;
    clearInterval(timerInt);
    let score = 0;
    currentQuestions.forEach((q, i) => { if (userAnswers[i] === q.ans) score++; });
    
    document.getElementById('exam-screen').style.display = 'none';
    document.getElementById('result-screen').style.display = 'block';
    
    document.getElementById('result-cat').innerText = activeCat === 'Cleaner' ? 'Cleaner' : 'Load & Unload';
    document.getElementById('final-score').innerText = score;
    document.getElementById('total-q-count').innerText = currentQuestions.length;
}

window.restartExam = function() {
    document.getElementById('result-screen').style.display = 'none';
    document.getElementById('exam-screen').style.display = 'block';
    userAnswers = {};
    initExam();
}

