document.getElementById('adminTrigger').onclick = () => {
    let pass = prompt("এডমিন পাসওয়ার্ড দিন:");
    if (pass === "1234") {
        document.getElementById('exam-screen').style.display = 'none';
        document.getElementById('result-screen').style.display = 'none';
        document.getElementById('admin-screen').style.display = 'block';
        
        document.getElementById('admin-cat-select').value = activeCat;
        window.loadAdminQuestionsList();
    } else if (pass) {
        alert("ভুল পাসওয়ার্ড!");
    }
};

window.closeAdmin = function() {
    document.getElementById('admin-screen').style.display = 'none';
    document.getElementById('exam-screen').style.display = 'block';
    initExam(); 
}

window.loadAdminQuestionsList = function() {
    const selCat = document.getElementById('admin-cat-select').value;
    document.getElementById('admin-cat-label').innerText = selCat;
    
    const listContainer = document.getElementById('admin-questions-list');
    listContainer.innerHTML = '';
    
    const qs = allData[selCat] || [];
    if(qs.length === 0) {
        listContainer.innerHTML = '<p style="color:red;">সার্ভারে কোনো প্রশ্ন নেই। নতুন যোগ করুন।</p>';
        return;
    }

    qs.forEach((q, index) => {
        let item = document.createElement('div');
        item.className = 'admin-q-item';
        
        let optsText = q.opts.map((opt, i) => {
            return i === q.ans ? `<span style="color:#4caf50; font-weight:bold;">${opt} (সঠিক)</span>` : opt;
        }).join(' | ');

        item.innerHTML = `
            <div>
                <div class="admin-q-text">${index + 1}. ${q.q}</div>
                <div class="admin-q-opts">${optsText}</div>
            </div>
            <button class="del-btn" onclick="deleteQuestion('${selCat}', ${index})">Delete</button>
        `;
        listContainer.appendChild(item);
    });
}

window.deleteQuestion = async function(cat, index) {
    if(confirm("সত্যিই এই প্রশ্নটি সার্ভার থেকে মুছে ফেলতে চান?")) {
        allData[cat].splice(index, 1);
        await saveDataToFirebase();
        window.loadAdminQuestionsList();
    }
}

window.quickFill = function(type) {
    if(type === 'yesno') {
        document.getElementById('admin-opt-a').value = 'হ্যাঁ';
        document.getElementById('admin-opt-b').value = 'না';
        document.getElementById('admin-opt-c').value = '';
        document.getElementById('admin-opt-d').value = '';
    } else if (type === 'truefalse') {
        document.getElementById('admin-opt-a').value = 'সত্য';
        document.getElementById('admin-opt-b').value = 'মিথ্যা';
        document.getElementById('admin-opt-c').value = '';
        document.getElementById('admin-opt-d').value = '';
    } else {
        document.getElementById('admin-opt-a').value = '';
        document.getElementById('admin-opt-b').value = '';
        document.getElementById('admin-opt-c').value = '';
        document.getElementById('admin-opt-d').value = '';
    }
}

window.addNewQuestion = async function() {
    const selCat = document.getElementById('admin-cat-select').value;
    const qText = document.getElementById('admin-q-text').value.trim();
    
    let optA = document.getElementById('admin-opt-a').value.trim();
    let optB = document.getElementById('admin-opt-b').value.trim();
    let optC = document.getElementById('admin-opt-c').value.trim();
    let optD = document.getElementById('admin-opt-d').value.trim();
    
    if(!qText || !optA || !optB) {
        alert("প্রশ্ন এবং অন্তত প্রথম দুটি (A ও B) অপশন দিতেই হবে!");
        return;
    }

    let optsArray = [optA, optB]; 
    if(optC) optsArray.push(optC);
    if(optD) optsArray.push(optD);
    
    let ans = parseInt(document.getElementById('admin-correct-ans').value);
    if(ans >= optsArray.length) {
        alert("সঠিক উত্তর হিসেবে যে অপশন সিলেক্ট করেছেন, সেই ঘরে আপনি কোনো লেখা দেননি!");
        return;
    }

    if(!allData[selCat]) allData[selCat] = [];
    allData[selCat].push({ q: qText, opts: optsArray, ans: ans });
    
    await saveDataToFirebase();
    
    document.getElementById('admin-q-text').value = '';
    window.quickFill('clear');
    window.loadAdminQuestionsList();
}

// অ্যাপ চালু হওয়ার সাথে সাথে সার্ভার থেকে ডাটা ফেচ করবে
fetchQuestionsFromFirebase();

